<Project>
  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), 'Directory.Build.props'))/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(StrideEditorTargetFramework)</TargetFramework>
    <!-- Referenced in-process (GameStudio, Presentation) AND run as a service: pack the runnable app under
         tools/<tfm>/ and keep lib/<tfm>/ to just the reference assembly, so consumers don't inherit the
         apphost or the resolver bootstrap dlls. The router exe is located by package file search. -->
    <StridePackRunnableInTools>true</StridePackRunnableInTools>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideAssemblyProcessorOptions>--auto-module-initializer</StrideAssemblyProcessorOptions>
    <StrideNuGetResolverUI>true</StrideNuGetResolverUI>
    <UseWindowsForms>true</UseWindowsForms>
    <StrideMultiGraphicsApiHost>true</StrideMultiGraphicsApiHost>
    <!-- These linked bootstrap types belong to this host; in-process consumers use Debugger's public API. -->
    <DefineConstants>$(DefineConstants);STRIDE_HOST_LOCAL_GRAPHICS_BOOTSTRAP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseVSHostingProcess>false</UseVSHostingProcess>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject />
    <ApplicationIcon>Resources\ConnectionRouter.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../shared/EditorServiceGraphicsBootstrap.cs" Link="EditorServiceGraphicsBootstrap.cs" />
    <Compile Include="../../shared/Stride.NuGetResolver/GraphicsApiSelector.cs" Link="GraphicsApiSelector.cs" />
    <Compile Include="../../shared/Stride.NuGetResolver/GraphicsApiHostResolver.cs" Link="GraphicsApiHostResolver.cs" />
    <PackageReference Include="Mono.Options" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\SharedAssemblyInfo.cs">
      <Link>Properties\SharedAssemblyInfo.cs</Link>
    </Compile>
    <Compile Include="..\..\shared\AttachedChildProcessJob.cs">
      <Link>AttachedChildProcessJob.cs</Link>
    </Compile>
    <Compile Include="..\..\shared\Process\AndroidDeviceEnumerator.cs">
      <Link>AndroidDeviceEnumerator.cs</Link>
    </Compile>
    <Compile Include="..\..\shared\LoaderToolLocator\LoaderToolLocator.cs" Link="LoaderToolLocator.cs" />
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\assets\Stride.Core.Assets\Stride.Core.Assets.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\ConnectionRouter.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ios-tcprelay\stride-ios-relay.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ios-tcprelay\usbmux.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="..\..\shared\Stride.Core.ShellHelper\Stride.Core.ShellHelper.projitems" Label="Shared" />
  <Import Project="..\..\shared\Stride.NuGetResolver.Targets\Stride.NuGetResolver.Targets.projitems" Label="Shared" />
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk.Editor/Sdk/Sdk.targets" />
  <Import Project="../../shared/EditorServiceDeployment.targets" />
</Project>
