<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GameValidation</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Stride.Engine/Stride.Engine.csproj" />
    <Content Include="../Stride.Graphics/**/*.sdsl;../Stride.Rendering/**/*.sdsl;../Stride.Engine/**/*.sdsl" Exclude="**/obj/**;**/bin/**" Link="Shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
