shader WebGpuBindingRanges
{
    StructuredBuffer<uint> Input;
    RWStructuredBuffer<uint> Values;
    [numthreads(1, 1, 1)]
    void CSMain()
    {
        uint count, stride;
        Input.GetDimensions(count, stride);
        Values[Input[0]] = count;
    }
};
