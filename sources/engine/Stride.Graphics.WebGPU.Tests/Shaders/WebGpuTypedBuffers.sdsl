shader WebGpuTypedBuffers
{
    stage stream uint3 DispatchThreadId : SV_DispatchThreadID;
    Buffer<uint> Input;
    Buffer<float4> Vectors;
    RWBuffer<uint> Output;
    [numthreads(8, 1, 1)]
    void CSMain()
    {
        uint count, vectorCount, outputCount;
        Input.GetDimensions(count);
        Vectors.GetDimensions(vectorCount);
        Output.GetDimensions(outputCount);
        uint i = streams.DispatchThreadId.x;
        Output[i] = Input.Load(i) * 3 + (uint)Vectors.Load(i).x + count + vectorCount + outputCount;
    }
};
