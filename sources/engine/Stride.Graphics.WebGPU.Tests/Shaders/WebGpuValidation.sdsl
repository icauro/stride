shader WebGpuValidation : SpriteBase
{
    stage override float4 Shading()
    {
#if STRIDE_GRAPHICS_API_WEBGPU
        return Texture0.Sample(Sampler, streams.TexCoord) * float4(0.25, 0.5, 0.75, 1);
#else
        return WebGPU_target_macro_is_required;
#endif
    }
};
