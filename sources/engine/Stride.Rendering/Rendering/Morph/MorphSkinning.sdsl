shader MorphSkinning<bool TDense> : MorphGpuCommon
{
    override void Compute()
    {
        uint vertex = streams.DispatchThreadId.x + streams.DispatchThreadId.y * 65535 * 64;
        if (vertex >= VertexCount) return;
        uint address = vertex * VertexStride;
        // Unchanged attributes are initialized once in the instance output buffer.
        float3 p = asfloat(Load3(address + PositionOffset));
        float3 n = NormalOffset >= 0 ? asfloat(Load3(address + NormalOffset)) : float3(0, 1, 0);
        float3 t = TangentOffset >= 0 ? asfloat(Load3(address + TangentOffset)) : float3(1, 0, 0);
        float3 dp = 0, dn = 0, dt = 0;
        if (ActiveCount != 0)
        {
            uint start = TDense ? 0 : VertexOffsets[vertex];
            uint end = TDense ? TargetCount : VertexOffsets[vertex + 1];
            for (uint item = start; item < end; item++)
            {
                uint entry = TDense ? item * VertexCount + vertex : item;
                uint shape = TDense ? item : PackedEntries[entry * 6 + 1] & 65535;
                float weight = Weights[shape];
                [branch]
                if (weight == 0) continue;
                uint v; float3 ep, en, et;
                Decode(entry, v, shape, ep, en, et);
                dp += ep * weight; dn += en * weight; dt += et * weight;
            }
        }
        p += dp; n += dn; t += dt;
        if (BoneCount != 0)
        {
            uint4 indices;
            if (Index16 != 0)
            {
                uint2 packed = Load2(address + BlendIndicesOffset);
                indices = uint4(packed.x & 65535, packed.x >> 16, packed.y & 65535, packed.y >> 16);
            }
            else
            {
                uint packed = Load(address + BlendIndicesOffset);
                indices = uint4(packed & 255, (packed >> 8) & 255, (packed >> 16) & 255, packed >> 24);
            }
            float4 weights = asfloat(Load4(address + BlendWeightsOffset));
            float3 skinnedP = 0, skinnedN = 0, skinnedT = 0;
            for (uint bone = 0; bone < 4; bone++)
            {
                if (weights[bone] == 0 || indices[bone] >= BoneCount) continue;
                uint row = indices[bone] * 4;
                float3 r0 = BoneRows[row].xyz, r1 = BoneRows[row + 1].xyz, r2 = BoneRows[row + 2].xyz;
                skinnedP += (p.x * r0 + p.y * r1 + p.z * r2 + BoneRows[row + 3].xyz) * weights[bone];
                skinnedN += (n.x * r0 + n.y * r1 + n.z * r2) * weights[bone];
                skinnedT += (t.x * r0 + t.y * r1 + t.z * r2) * weights[bone];
            }
            p = skinnedP; n = skinnedN; t = skinnedT;
        }
        n = SafeNormal(n, float3(0, 1, 0));
        float3 tangentFallback = SafeNormal(cross(abs(n.x) < 0.9 ? float3(1, 0, 0) : float3(0, 1, 0), n), float3(0, 0, 1));
        t = SafeNormal(t - n * dot(n, t), tangentFallback);
        Store3(address + PositionOffset, asuint(p));
        if (NormalOffset >= 0) Store3(address + NormalOffset, asuint(n));
        // The copied tangent.w preserves imported bitangent handedness.
        if (TangentOffset >= 0) Store3(address + TangentOffset, asuint(t));
    }
};
