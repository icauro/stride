<Project>
  <PropertyGroup>
    <StrideRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))</StrideRoot>
    <DirectoryPackagesPropsPath>$(StrideRoot)sources/Directory.Packages.props</DirectoryPackagesPropsPath>
  </PropertyGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.props" />
  <PropertyGroup>
    <TargetFramework>$(StrideFramework)</TargetFramework>
    <TargetFramework Condition="'$(StridePlatforms)' == 'Browser'">$(StrideFrameworkBrowser)</TargetFramework>
    <!-- Serialized sample scripts use this assembly identity. -->
    <AssemblyName>SpaceEscape.Game</AssemblyName>
    <RootNamespace>SpaceEscape</RootNamespace>
    <IsPackable>false</IsPackable>
    <StrideAssemblyProcessor>true</StrideAssemblyProcessor>
    <StrideSkipAutoPack>true</StrideSkipAutoPack>
    <StrideAssemblyProcessorFramework>net10.0</StrideAssemblyProcessorFramework>
    <SampleSource>$(StrideRoot)samples/Games/SpaceEscape/SpaceEscape.Game/</SampleSource>
    <StrideCurrentPackagePath>$(SampleSource)SpaceEscape.Game.sdpkg</StrideCurrentPackagePath>
    <StrideContainsAssetTypes>true</StrideContainsAssetTypes>
    <!-- Desktop preparation loads asset compilers; the browser ships runtime assemblies only. -->
    <StrideBuildCompanionProjects Condition="'$(StridePlatforms)' != 'Browser'">true</StrideBuildCompanionProjects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SampleSource)**/*.cs" Exclude="$(SampleSource)bin/**/*;$(SampleSource)obj/**/*" Link="Sample/%(RecursiveDir)%(Filename)%(Extension)" />
    <StrideShaderFiles Include="$(SampleSource)Effects/*.sdsl;$(SampleSource)Effects/*.sdfx" />
    <StrideAssetNamespaceUsing Include="Stride.Engine" />
    <ProjectReference Include="$(StrideRoot)sources/engine/Stride.Engine/Stride.Engine.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/engine/Stride.UI/Stride.UI.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/engine/Stride.Particles/Stride.Particles.csproj" />
  </ItemGroup>
  <Import Project="$(StrideRoot)sources/sdk/Stride.Build.Sdk/Sdk/Sdk.targets" />
</Project>
