<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ComputeSkinningSample</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>../Bin/Windows/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)../ComputeSkinningSample.Game/ComputeSkinningSample.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Windows</StridePlatform>
    <StrideRoot>$(MSBuildThisFileDirectory)../../../../</StrideRoot>
    <DefineConstants Condition="'$(StrideGraphicsApi)' == 'Vulkan'">$(DefineConstants);VULKAN</DefineConstants>
    <!-- Copy only the win-x64 native libraries, not those of every platform the engine packages ship. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Package documentation (.xml) is for the IDE, and Release ships without debug symbols. -->
  <Target Name="TrimCopiedPackageFiles" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.xml' Or ('$(Configuration)' == 'Release' And '%(Extension)' == '.pdb')" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="$(StrideRoot)deps/BulletPhysics/dotnet/win-x64/libbulletc.dll" Link="runtimes/win-x64/native/libbulletc.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StrideRoot)deps/freetype/dotnet/win-x64/freetype.dll" Link="runtimes/win-x64/native/freetype.dll" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../ComputeSkinningSample.Game/ComputeSkinningSample.Game.csproj" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.5.0-dev" IncludeAssets="build;buildTransitive" />
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
  </ItemGroup>
  <!-- The benchmark runner compiles effects at runtime from the engine shader sources. -->
  <Target Name="CopyBenchmarkShaders" AfterTargets="Build">
    <ItemGroup>
      <BenchmarkShader Include="$(StrideRoot)sources/engine/Stride.Graphics/**/*.sdsl;$(StrideRoot)sources/engine/Stride.Rendering/**/*.sdsl;$(StrideRoot)sources/engine/Stride.Engine/**/*.sdsl" Exclude="$(StrideRoot)**/obj/**;$(StrideRoot)**/bin/**" />
    </ItemGroup>
    <Copy SourceFiles="@(BenchmarkShader)" DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
