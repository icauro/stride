<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>ComputeSkinningSample.Android</RootNamespace>
    <OutputPath>..\Bin\Android\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationId>com.stride.computeskinningsample</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <!-- Use AssemblyName for Resource class to avoid clashes between ComputeSkinningSample and ComputeSkinningSample.Android -->
    <AndroidResgenNamespace>$(AssemblyName)</AndroidResgenNamespace>
    <StrideCurrentPackagePath>$(MSBuildThisFileDirectory)..\ComputeSkinningSample.Game\ComputeSkinningSample.Game.sdpkg</StrideCurrentPackagePath>
    <StridePlatform>Android</StridePlatform>
    <AndroidApplicationIcon>@mipmap/appicon</AndroidApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ComputeSkinningSample.Game\ComputeSkinningSample.Game.csproj" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.5.0-dev" IncludeAssets="build;buildTransitive" />
  </ItemGroup>
</Project>
