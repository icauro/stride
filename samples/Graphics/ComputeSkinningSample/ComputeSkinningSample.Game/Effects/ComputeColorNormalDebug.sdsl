// Shows the world-space normal as a color (-1..1 mapped to 0..1). Used as an emissive color,
// so morphed and skinned normals are visible without textures or lighting.
shader ComputeColorNormalDebug : ComputeColor, NormalStream
{
    override float4 Compute()
    {
        return float4(normalize(streams.normalWS) * 0.5 + 0.5, 1);
    }
};
