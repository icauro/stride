<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StrideCompileAssets>false</StrideCompileAssets>
    <StrideRoot Condition="'$(StrideRoot)' == ''">$(MSBuildThisFileDirectory)../../../../</StrideRoot>
    <MorphImplementation Condition="'$(MorphImplementation)' == ''">Our</MorphImplementation>
    <OutputPath Condition="'$(SceneOutputRoot)' != ''">$(SceneOutputRoot)/</OutputPath>
    <DefineConstants Condition="'$(MorphImplementation)' == 'Nala'">$(DefineConstants);NALA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <None Include="$(StrideRoot)sources/engine/Stride.Graphics/**/*.sdsl;$(StrideRoot)sources/engine/Stride.Rendering/**/*.sdsl;$(StrideRoot)sources/engine/Stride.Engine/**/*.sdsl" Exclude="$(StrideRoot)**/obj/**;$(StrideRoot)**/bin/**" Link="shaders/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StrideRoot)deps/BulletPhysics/dotnet/win-x64/libbulletc.dll" Link="runtimes/win-x64/native/libbulletc.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(StrideRoot)deps/freetype/dotnet/win-x64/freetype.dll" Link="runtimes/win-x64/native/freetype.dll" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Playback/MorphWorkload.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/engine/Stride.Engine/Stride.Engine.csproj" />
    <ProjectReference Include="$(StrideRoot)sources/tools/Stride.Importer.3D/Stride.Importer.3D.csproj" />
  </ItemGroup>
  <Target Name="ValidateImplementation" BeforeTargets="Build">
    <Error Condition="'$(MorphImplementation)' != 'Our' and '$(MorphImplementation)' != 'Nala'" Text="MorphImplementation must be Our or Nala." />
  </Target>
</Project>
